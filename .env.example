# 本地密钥，已在 .gitignore，不会提交。填完保存即可。

# OneMap（https://www.onemap.gov.sg/apidocs/）
# 二选一：填邮箱密码，代码自动换 token 并续期；或者直接填 access token（72 小时过期）
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_TOKEN=


# LLM backend for the agents (see core/llm.py)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# LLM_MODEL=deepseek-chat
# Optional free local inference (requires Ollama running on this computer):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# See docs/local-model-testing.md. Local runs are a separate benchmark condition.

# stretch modules (service defaults them on; set 0 for the bare MVP)
STRETCH_PRECEDENT=1
STRETCH_FRAUD=1
STRETCH_SLA=1
STRETCH_FEEDBACK=1
